{
    "swagger": "2.0",
    "info": {
        "title": "Purchasing System API",
        "description": "API for managing purchasing, sorting, and inventory operations.",
        "version": "1.0"
    },
    "host": "127.0.0.1:8082",
    "basePath": "/api",
    "schemes": ["http", "https"],
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        }
    },
    "paths": {
        "/signin": {
            "post": {
                "summary": "User Sign-in",
                "description": "Authenticate a user and create a session token.",
                "consumes": ["application/x-www-form-urlencoded"],
                "parameters": [
                    { "name": "username", "in": "formData", "required": true, "type": "string" },
                    { "name": "password", "in": "formData", "required": true, "type": "string" }
                ],
                "responses": {
                    "200": { "description": "Successful login, returns session token." },
                    "401": { "description": "Unauthorized - Invalid credentials." }
                }
            }
        },
        "/logout": {
            "get": {
                "summary": "User Logout",
                "description": "Terminates a user session by deleting the session token.",
                "responses": {
                    "303": { "description": "Redirects to login page." }
                }
            }
        },
        "/users": {
            "get": {
                "summary": "List Users",
                "description": "Retrieve a paginated list of users with optional filters.",
                "parameters": [
                    { "name": "role", "in": "query", "type": "string", "description": "Filter by role" },
                    { "name": "page", "in": "query", "type": "integer", "default": 1 },
                    { "name": "limit", "in": "query", "type": "integer", "default": 100 }
                ],
                "responses": {
                    "200": {
                        "description": "List of users",
                        "schema": { "type": "array", "items": { "$ref": "#/definitions/User" } }
                    }
                }
            }
        },
        "/userupdate": {
            "post": {
                "summary": "Update User",
                "description": "Update user details such as role, permissions, and management status.",
                "parameters": [
                    { "name": "user", "in": "body", "required": true, "schema": { "$ref": "#/definitions/User" } }
                ],
                "responses": {
                    "200": { "description": "User updated successfully." },
                    "400": { "description": "Bad Request." },
                    "500": { "description": "Internal Server Error." }
                }
            }
        },
        "/products": {
            "get": {
                "summary": "List Products",
                "description": "Retrieve a list of products with optional filters.",
                "parameters": [
                    { "name": "sku", "in": "query", "type": "string", "description": "Filter by SKU" },
                    { "name": "manufacturer", "in": "query", "type": "string", "description": "Filter by manufacturer" },
                    { "name": "limit", "in": "query", "type": "integer", "default": 100 }
                ],
                "responses": {
                    "200": { "description": "List of products", "schema": { "type": "array", "items": { "$ref": "#/definitions/Product" } } }
                }
            }
        },
        "/manufacturers": {
            "get": {
                "summary": "List Manufacturers",
                "description": "Retrieve a list of manufacturers.",
                "responses": {
                    "200": { "description": "List of manufacturers", "schema": { "type": "array", "items": { "$ref": "#/definitions/Manufacturer" } } }
                }
            }
        },
        "/sortinglist": {
            "get": {
                "summary": "List Sorting Requests",
                "description": "Retrieve sorting requests with optional filters.",
                "parameters": [
                    { "name": "sku", "in": "query", "type": "string", "description": "Filter by SKU" },
                    { "name": "sorter", "in": "query", "type": "string", "description": "Filter by sorter" },
                    { "name": "status", "in": "query", "type": "string", "description": "Filter by status" }
                ],
                "responses": {
                    "200": { "description": "List of sorting requests", "schema": { "type": "array", "items": { "$ref": "#/definitions/SortRequest" } } }
                }
            }
        },
        "/export": {
            "get": {
                "summary": "Export Data",
                "description": "Export data from the system as a CSV file.",
                "parameters": [
                    { "name": "dataset", "in": "query", "required": true, "type": "string", "description": "Dataset to export" }
                ],
                "responses": {
                    "200": { "description": "CSV file", "schema": { "type": "string", "format": "binary" } }
                }
            }
        }
    },
    "definitions": {
        "User": {
            "type": "object",
            "properties": {
                "username": { "type": "string" },
                "usercode": { "type": "string" },
                "role": { "type": "string" },
                "sorting": { "type": "boolean" },
                "manager": { "type": "boolean" },
                "management": { "type": "boolean" }
            }
        },
        "Product": {
            "type": "object",
            "properties": {
                "sku": { "type": "string" },
                "manufacturer": { "type": "string" },
                "description": { "type": "string" },
                "price": { "type": "number", "format": "float" }
            }
        },
        "Manufacturer": {
            "type": "object",
            "properties": {
                "name": { "type": "string" }
            }
        },
        "SortRequest": {
            "type": "object",
            "properties": {
                "id": { "type": "integer" },
                "sku": { "type": "string" },
                "description": { "type": "string" },
                "sorter": { "type": "string" },
                "status": { "type": "string" }
            }
        }
    }
}
